# =============================================================================
# AUTONOMOUS VIRAL REELS ENGINE - ENVIRONMENT CONFIGURATION
# =============================================================================
# The pipeline is built with a zero-cost failover cascade. All keys are optional.
# If a key is missing or hits a rate-limit (HTTP 429), the engine automatically
# falls back to the next provider down to 100% keyless emergency tiers.

# -----------------------------------------------------------------------------
# 1. SCRIPT GENERATION CASCADE KEYS (Optional / Free Tiers)
# -----------------------------------------------------------------------------
# Tier 1: Google Gemini Flash (Get free key: https://aistudio.google.com/)
GEMINI_API_KEY=

# Tier 2: Groq Cloud API (Llama 3.3 70B, free ultra-fast: https://console.groq.com/)
GROQ_API_KEY=

# Tier 3: OpenRouter or DeepSeek Free Tier (https://openrouter.ai/ or https://platform.deepseek.com/)
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Tier 4: Cohere API (Command-R free tier: https://dashboard.cohere.com/)
COHERE_API_KEY=

# (Tier 5 is 100% KEYLESS: Pollinations AI Text - no key required)

# Premium LLM (Optional):
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# 2. VISUAL GENERATION CASCADE KEYS (Optional / Free Tiers)
# -----------------------------------------------------------------------------
# (Tier 1 is 100% KEYLESS: Pollinations AI FLUX - no key required)

# Tier 2: Hugging Face Serverless Inference (Free token: https://huggingface.co/settings/tokens)
HF_TOKEN=
HUGGINGFACE_API_TOKEN=

# Tier 3: Together AI Free Tier (https://api.together.xyz/)
TOGETHER_API_KEY=

# (Tier 4 is LOCAL: assets/fallback_vault/ - zero internet required)

# -----------------------------------------------------------------------------
# 3. VOICE SYNTHESIS CASCADE KEYS
# -----------------------------------------------------------------------------
# Tier 1 & Tier 2: Microsoft Edge Neural TTS (100% FREE & KEYLESS)
# Tier 3: Google Translate TTS (gTTS) (100% FREE & KEYLESS)

# Premium Voice (Optional):
ELEVENLABS_API_KEY=

# -----------------------------------------------------------------------------
# 4. TREND RESEARCH KEYS (Optional)
# -----------------------------------------------------------------------------
# Free Search APIs (Engine includes built-in 35+ Discovery Vault if empty):
TAVILY_API_KEY=
PERPLEXITY_API_KEY=

# -----------------------------------------------------------------------------
# 5. YOUTUBE CLOUD PUBLISHING KEYS (For GitHub Actions Auto-Uploader)
# -----------------------------------------------------------------------------
# Option A (Recommended for GitHub Actions Secrets - Single-line strings):
YOUTUBE_CLIENT_SECRET_BASE64=
YOUTUBE_REFRESH_TOKEN=

# Option B (Alternative - Raw JSON strings):
CLIENT_SECRETS_JSON=
YOUTUBE_TOKEN_JSON=
